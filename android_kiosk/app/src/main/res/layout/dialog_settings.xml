<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/card_dark">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Server Configuration"
        android:textColor="@color/gold_bright"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Enter your hosted backend URL (including https://)"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etServerUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/rounded_card"
        android:padding="12dp"
        android:hint="https://your-domain.onrender.com"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_muted"
        android:inputType="textUri"
        android:singleLine="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Scan Endpoint: [URL]/api/scan"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

</LinearLayout>

